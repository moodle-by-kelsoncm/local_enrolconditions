{{!
    @template local_enrolconditions/failures_list

    Nested list of unmet conditions; includes itself for the children.

    Context variables required for this template:
    * items - List of items, each with message (HTML formatted by the condition), haschildren and items.

    Example context (json):
    {
        "items": [
            {"message": "Your city must be Natal.", "haschildren": false, "items": []}
        ]
    }
}}
<ul class="mb-0">
    {{#items}}
    <li>{{{message}}}{{#haschildren}}{{> local_enrolconditions/failures_list }}{{/haschildren}}</li>
    {{/items}}
</ul>
