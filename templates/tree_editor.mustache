{{!
    @template local_enrolconditions/tree_editor

    Container of the condition tree editor, filled by the AMD module local_enrolconditions/tree_editor.

    Context variables required for this template:
    * uniqid - Id of the container.
    * config - JSON with the field name, context id, condition types and the tree.

    Example context (json):
    {
        "uniqid": "local_enrolconditions_editor1",
        "config": "{}"
    }
}}
<div id="{{uniqid}}" class="local_enrolconditions-editor w-100" data-region="local_enrolconditions-editor" data-config="{{config}}">
    <p class="text-muted" data-region="local_enrolconditions-noscript">{{#str}}editornoscript, local_enrolconditions{{/str}}</p>
</div>
